{
  "info": {
    "name": "DevFlow API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "orgId", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "taskId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login (Demo User)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.access_token) pm.collectionVariables.set('accessToken', json.access_token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"demo@devflow.dev\",\"password\":\"DemoPass123!\"}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "2. List Organizations",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const arr = pm.response.json();",
              "if (Array.isArray(arr) && arr.length) pm.collectionVariables.set('orgId', arr[0].id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/organizations"
      }
    },
    {
      "name": "3. List Projects",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.items && res.items.length) pm.collectionVariables.set('projectId', res.items[0].id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/organizations/{{orgId}}/projects"
      }
    },
    {
      "name": "4. Create Task",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.id) pm.collectionVariables.set('taskId', res.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Postman sample task\",\"priority\":\"medium\"}"
        },
        "url": "{{baseUrl}}/projects/{{projectId}}/tasks"
      }
    },
    {
      "name": "5. Add Comment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"body\":\"Commented via Postman\"}"
        },
        "url": "{{baseUrl}}/tasks/{{taskId}}/comments"
      }
    }
  ]
}

