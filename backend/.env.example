# DevFlow Backend Environment Configuration
# Copy to .env for local development. Never commit real secrets.

ENVIRONMENT=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Database: SQLite works out of the box locally; PostgreSQL in Docker/CI/Prod
# Postgres example: postgresql+psycopg2://devflow:devflow@localhost:5432/devflow
DATABASE_URL=sqlite:///./devflow.db
TEST_DATABASE_URL=

# Security (REQUIRED to change in production; app refuses default in production)
SECRET_KEY=devflow-local-dev-secret-key-change-in-production-32chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_RESET_TTL_MINUTES=30

# CORS & Frontend URL (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Optional Redis for distributed WebSocket pub/sub and rate limiting
REDIS_URL=

# Rate limiting (10 req/min/IP on auth endpoints)
RATE_LIMIT_ENABLED=true

